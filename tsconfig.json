{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": ".runtime/build"
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
