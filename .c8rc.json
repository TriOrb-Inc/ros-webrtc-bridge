{
  "all": true,
  "src": [
    "packages/bridge/src",
    "scripts"
  ],
  "include": [
    "packages/bridge/src/**/*.ts",
    "scripts/credential-store.mjs"
  ],
  "extension": [
    ".ts",
    ".mjs"
  ],
  "exclude-after-remap": true,
  "check-coverage": true,
  "per-file": true,
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100,
  "reporter": [
    "text",
    "json-summary",
    "json",
    "lcov"
  ],
  "reports-dir": ".runtime/coverage"
}
