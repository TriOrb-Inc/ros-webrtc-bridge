#!/usr/bin/env bash
set -euo pipefail

# Load the bundled runtime using an absolute file URL from the wrapper under
# ament's lib/<package>. Inherit BRIDGE_* and ROS_* directly from the caller's environment.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
entrypoint="${script_dir}/dist/app/cli.js"

exec node --input-type=module --eval '
  import { pathToFileURL } from "node:url";
  try {
    const bridge = await import(pathToFileURL(process.argv[1]).href);
    await bridge.main();
  } catch {
    console.error("Bridge startup failed");
    process.exitCode = 1;
  }
' "${entrypoint}"
